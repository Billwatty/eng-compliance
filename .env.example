# Copy to .env and export before running. Nothing here is required for the demo.

# Claude API, for AI reading of lab reports, certificates and specifications.
# Either set a key or run `ant auth login`. Without credentials, values are entered by hand.
ANTHROPIC_API_KEY=
VBC_MODEL=claude-opus-5-5
VBC_EXTRACTION_EFFORT=medium
VBC_RULE_DRAFT_EFFORT=high
# Server-side refusal fallback (Claude API only). Set to 0 on Bedrock, Vertex or Foundry.
VBC_USE_FALLBACKS=1

# Where the database and file vault live.
VBC_DATA_DIR=./var

# WhatsApp Business Platform (Cloud API) webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
